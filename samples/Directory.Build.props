<Project>

	<!-- Inherit the repo-wide build gate. The samples are held to the same analyzer bar as src/. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)../))" />

	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<!-- The samples' suites demonstrate the parsers rather than cover them, so they sit below the library's
		     floor: measured 68.04/64.47/74.28 (Math.Parser) and 68.15/36.52/61.84 (Predicate.Parser). Seeded under
		     the lower of the two on each axis. Raise only — never lower. -->
		<Threshold>68,36,61</Threshold>
	</PropertyGroup>

</Project>
