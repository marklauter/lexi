<Project>

	<!-- Inherit the repo-wide build gate. The samples are held to the same analyzer bar as src/. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)../))" />

	<!-- The samples' suites demonstrate the parsers rather than cover them, so they sit below the library's floor.
	     Each suite carries its OWN floor, seeded at its measured line,branch,method. A single shared floor took the
	     minimum of each axis across both suites, which gated Math.Parsing's 64% branch coverage at Predicate's 37%
	     and let a 27-point regression there pass silently. Raise only — never lower. A new sample .Tests project
	     seeds its own block here after its first green run. -->
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Math.Parsing.Tests'">
		<!-- measured 99.48/97.36/100. Residual: ParseNumber's unreachable NotANumber default arm and the
		     relational-or pattern nodes in SymbolExtensions the analyzer counts but iteration can't all hit. -->
		<Threshold>99,97,100</Threshold>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Predicate.Parsing.Tests'">
		<!-- Release-measured 98.79/92.8/100 (branch coverage is config-dependent; CI runs Release, so the floor
		     must hold there, not just in Debug's 93.79). Residual branch: unreachable defensive `_ => X.ToString()`
		     defaults in the guarded ToString switches and the unimplemented array/object literal arms in ParseLiteral. -->
		<Threshold>98,92,100</Threshold>
	</PropertyGroup>

</Project>
