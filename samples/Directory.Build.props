<Project>

	<!-- Inherit the repo-wide build gate, then relax the public-API design rules for the samples. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)../))" />

	<PropertyGroup>
		<!-- The samples are non-packable demonstration parsers, not shipped API. The rules below all govern the
		     design of a public surface that external callers consume; none of them has a caller here, and honouring
		     them would bury the lexing the samples exist to demonstrate under conversion and guard-clause ceremony.
		     The scaffolding-csharp template draws the same packable/non-packable line for CA1062.
		     CA1028 enum-storage-should-be-int32 : token ids are uint to match Lexi's Symbol.TokenId. -->
		<!-- CA1031 do-not-catch-general-exception-types : the REPLs catch-all at the read-eval-print loop so a bad
		            expression prints an error and returns to the prompt instead of killing the process. -->
		<!-- CA1062 validate-arguments-of-public-methods : nullable reference types are the null contract; these
		            assemblies are referenced only by the samples' own tests and REPLs, which compile against it. -->
		<!-- CA1065 do-not-raise-exceptions-in-unexpected-locations : the AST conversion operators and ToString
		            overrides throw on malformed nodes, which is the samples' way of showing parse errors. -->
		<!-- CA1724 type-names-should-not-match-namespaces : `Parser` in namespace `<Sample>.Parser` is the
		            deliberate shape of the sample; renaming either half would make the walkthrough harder to read. -->
		<!-- CA2225 operator-overloads-have-named-alternates : the AST literal types lean on implicit conversions
		            for readability; named alternates would double the surface of demo types nobody calls by name. -->
		<NoWarn>$(NoWarn);CA1028;CA1031;CA1062;CA1065;CA1724;CA2225</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<!-- The samples' suites demonstrate the parsers rather than cover them, so they sit below the library's
		     floor: measured 68.04/64.47/74.28 (Math.Parser) and 68.15/36.52/61.84 (Predicate.Parser). Seeded under
		     the lower of the two on each axis. Raise only — never lower. -->
		<Threshold>68,36,61</Threshold>
	</PropertyGroup>

</Project>
